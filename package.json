{
  "name": "agentic-ai-qa",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:allure-results": "node scripts/clean-allure-results.mjs",
    "test:e2e": "npm run clean:allure-results && playwright test",
    "test:e2e:checkout": "npm run test:e2e",
    "test:e2e:checkout:chromium": "npm run clean:allure-results && playwright test --project=chromium",
    "test:smoke": "npm run clean:allure-results && playwright test --grep @smoke",
    "report:allure": "node node_modules/allure-commandline/bin/allure generate allure-results --clean -o allure-report",
    "report:allure:open": "node node_modules/allure-commandline/bin/allure open allure-report",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^2.15.1",
    "typescript": "^7.0.2"
  }
}
